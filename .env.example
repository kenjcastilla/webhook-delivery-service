# App
NODE_ENV=development
NODE_PORT=3000 # Default port for Node.js (e.g. Express, Next.js is 3000)

# PostgreSQL
DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379 # Default Redis port is 6379
REDIS_PASSWORD=

# Webhook delivery values
DELIVERY_CONCURRENCY=5        # How many jobs to process in parallel
MAX_DELIVERY_ATTEMPTS=5       # Max retries before marking DEAD
INITIAL_RETRY_DELAY_MS=5000   # 5s before first retry